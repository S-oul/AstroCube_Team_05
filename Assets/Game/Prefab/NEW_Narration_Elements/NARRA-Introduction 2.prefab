--- !u!114 &2696510430782885271
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 8264688795476783686}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Master, classes at the university have not been going as I expected. \nTeaching
    about the stars while knowing you might be among them... \nIt is harder than
    I want to admit.\r\n \r\nI know that\u2019s what you wanted, for me to take your
    place and carry your legacy.\r\nI swore I would, but right now... I might go
    back on my words.\n\r\nYour hard stare over my shoulder, your harsh and well
    advised words, they made me who I am. \nThinking I could fail your teachings
    makes me scared to lose what is left of you.\r\n\r\nMy brother told me I should
    move on, that this pain will end. \nWeeks have past and yet, your last words
    still echo in my head:"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: b7c7eb4c392b50743842bd28c3a46d7a, type: 2}
  m_sharedMaterial: {fileID: -5418766915303222515, guid: b7c7eb4c392b50743842bd28c3a46d7a,
    type: 2}
