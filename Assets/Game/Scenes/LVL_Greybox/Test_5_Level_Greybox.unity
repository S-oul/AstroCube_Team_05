    - target: {fileID: 4213974095151647054, guid: 6ce0cebe207ad3a43928c373e8daa03a,
        type: 3}
      propertyPath: _memories.Array.size
      value: 3
      objectReference: {fileID: 0}
    - target: {fileID: 4213974095151647054, guid: 6ce0cebe207ad3a43928c373e8daa03a,
        type: 3}
      propertyPath: _subtitles.Array.size
      value: 24
      objectReference: {fileID: 0}
    - target: {fileID: 4213974095151647054, guid: 6ce0cebe207ad3a43928c373e8daa03a,
        type: 3}
      propertyPath: '_memories.Array.data[1]'
      value: 
      objectReference: {fileID: 1970673785}
    - target: {fileID: 4213974095151647054, guid: 6ce0cebe207ad3a43928c373e8daa03a,
        type: 3}
      propertyPath: '_memories.Array.data[2]'
      value: 
      objectReference: {fileID: 887336122}
    - target: {fileID: 4213974095151647054, guid: 6ce0cebe207ad3a43928c373e8daa03a,
        type: 3}
      propertyPath: '_subtitles.Array.data[0]'
      value: Brother, let it go.
      objectReference: {fileID: 0}
    - target: {fileID: 4213974095151647054, guid: 6ce0cebe207ad3a43928c373e8daa03a,
        type: 3}
      propertyPath: '_subtitles.Array.data[1]'
      value: "No Mariam, I want to understand this fully. So\u2026"
      objectReference: {fileID: 0}
    - target: {fileID: 4213974095151647054, guid: 6ce0cebe207ad3a43928c373e8daa03a,
        type: 3}
      propertyPath: '_subtitles.Array.data[2]'
      value: 'We agree that knowledge of all things  is the ultimate goal for you
        men of science right?  '
      objectReference: {fileID: 0}
    - target: {fileID: 4213974095151647054, guid: 6ce0cebe207ad3a43928c373e8daa03a,
        type: 3}
      propertyPath: '_subtitles.Array.data[3]'
      value: 'We rarely have the opportunity to talk like this  you and me Nastulus,
        so please tell me. '
      objectReference: {fileID: 0}
    - target: {fileID: 4213974095151647054, guid: 6ce0cebe207ad3a43928c373e8daa03a,
        type: 3}
      propertyPath: '_subtitles.Array.data[4]'
      value: "Yes, I- I thought this too when I was younger, but\u2026"
      objectReference: {fileID: 0}
    - target: {fileID: 4213974095151647054, guid: 6ce0cebe207ad3a43928c373e8daa03a,
        type: 3}
      propertyPath: '_subtitles.Array.data[5]'
      value: To be honest, Ayoub, this could not be further from the truth.
      objectReference: {fileID: 0}
    - target: {fileID: 4213974095151647054, guid: 6ce0cebe207ad3a43928c373e8daa03a,
        type: 3}
      propertyPath: '_subtitles.Array.data[6]'
      value: How so ?
      objectReference: {fileID: 0}
    - target: {fileID: 4213974095151647054, guid: 6ce0cebe207ad3a43928c373e8daa03a,
        type: 3}
      propertyPath: '_subtitles.Array.data[7]'
      value: 'What is knowledge without meaning? '
      objectReference: {fileID: 0}
    - target: {fileID: 4213974095151647054, guid: 6ce0cebe207ad3a43928c373e8daa03a,
        type: 3}
      propertyPath: '_subtitles.Array.data[8]'
      value: 'Ayoub, under our imam you have dedicated your life  to meaning, I have
        dedicated mine to knowledge,  but is this not wrong? '
      objectReference: {fileID: 0}
    - target: {fileID: 4213974095151647054, guid: 6ce0cebe207ad3a43928c373e8daa03a,
        type: 3}
      propertyPath: '_subtitles.Array.data[9]'
      value: "Shouldn\u2019t the scientist  and the philosopher work hand in hand? "
      objectReference: {fileID: 0}
    - target: {fileID: 4213974095151647054, guid: 6ce0cebe207ad3a43928c373e8daa03a,
        type: 3}
      propertyPath: _subtitleDurationByLetter
      value: 0.08
      objectReference: {fileID: 0}
    - target: {fileID: 4213974095151647054, guid: 6ce0cebe207ad3a43928c373e8daa03a,
        type: 3}
      propertyPath: '_subtitles.Array.data[10]'
      value: Rubbish...
      objectReference: {fileID: 0}
    - target: {fileID: 4213974095151647054, guid: 6ce0cebe207ad3a43928c373e8daa03a,
        type: 3}
      propertyPath: '_subtitles.Array.data[11]'
      value: Excuse me?
      objectReference: {fileID: 0}
    - target: {fileID: 4213974095151647054, guid: 6ce0cebe207ad3a43928c373e8daa03a,
        type: 3}
      propertyPath: '_subtitles.Array.data[12]'
      value: 'All of your questions have already been answered old man. '
      objectReference: {fileID: 0}
    - target: {fileID: 4213974095151647054, guid: 6ce0cebe207ad3a43928c373e8daa03a,
        type: 3}
      propertyPath: '_subtitles.Array.data[13]'
      value: How long has it been since you last opened the holy Quran?
      objectReference: {fileID: 0}
    - target: {fileID: 4213974095151647054, guid: 6ce0cebe207ad3a43928c373e8daa03a,
        type: 3}
      propertyPath: '_subtitles.Array.data[14]'
      value: Ayoub!
      objectReference: {fileID: 0}
    - target: {fileID: 4213974095151647054, guid: 6ce0cebe207ad3a43928c373e8daa03a,
        type: 3}
      propertyPath: '_subtitles.Array.data[15]'
      value: No no no. Let him answer.
      objectReference: {fileID: 0}
    - target: {fileID: 4213974095151647054, guid: 6ce0cebe207ad3a43928c373e8daa03a,
        type: 3}
      propertyPath: '_subtitles.Array.data[16]'
      value: No no no. Let him answer.
      objectReference: {fileID: 0}
    - target: {fileID: 4213974095151647054, guid: 6ce0cebe207ad3a43928c373e8daa03a,
        type: 3}
      propertyPath: _subtitles.Array.data[0].text
      value: Brother, let it go.
      objectReference: {fileID: 0}
    - target: {fileID: 4213974095151647054, guid: 6ce0cebe207ad3a43928c373e8daa03a,
        type: 3}
      propertyPath: _subtitles.Array.data[1].text
      value: "No Mariam, I want to understand this fully. So\u2026"
      objectReference: {fileID: 0}
    - target: {fileID: 4213974095151647054, guid: 6ce0cebe207ad3a43928c373e8daa03a,
        type: 3}
      propertyPath: _subtitles.Array.data[3].text
      value: We agree that knowledge of all things is the ultimate goal for you men
        of science right?
      objectReference: {fileID: 0}
    - target: {fileID: 4213974095151647054, guid: 6ce0cebe207ad3a43928c373e8daa03a,
        type: 3}
      propertyPath: _subtitles.Array.data[4].text
      value: 'We rarely have the opportunity to talk like this you and me Nastulus,
        so please tell me. '
      objectReference: {fileID: 0}
    - target: {fileID: 4213974095151647054, guid: 6ce0cebe207ad3a43928c373e8daa03a,
        type: 3}
      propertyPath: _subtitles.Array.data[5].text
      value: 
      objectReference: {fileID: 0}
    - target: {fileID: 4213974095151647054, guid: 6ce0cebe207ad3a43928c373e8daa03a,
        type: 3}
      propertyPath: _subtitles.Array.data[6].text
      value: "Yes, I- I thought this too when I was younger, but\u2026"
      objectReference: {fileID: 0}
    - target: {fileID: 4213974095151647054, guid: 6ce0cebe207ad3a43928c373e8daa03a,
        type: 3}
      propertyPath: _subtitles.Array.data[7].text
      value: 
      objectReference: {fileID: 0}
    - target: {fileID: 4213974095151647054, guid: 6ce0cebe207ad3a43928c373e8daa03a,
        type: 3}
      propertyPath: _subtitles.Array.data[8].text
      value: 'To be honest, Ayoub, this could not be further from the truth. '
      objectReference: {fileID: 0}
    - target: {fileID: 4213974095151647054, guid: 6ce0cebe207ad3a43928c373e8daa03a,
        type: 3}
      propertyPath: _subtitles.Array.data[9].text
      value: How so ?
      objectReference: {fileID: 0}
    - target: {fileID: 4213974095151647054, guid: 6ce0cebe207ad3a43928c373e8daa03a,
        type: 3}
      propertyPath: _subtitles.Array.data[10].text
      value: What is knowledge without meaning?
      objectReference: {fileID: 0}
    - target: {fileID: 4213974095151647054, guid: 6ce0cebe207ad3a43928c373e8daa03a,
        type: 3}
      propertyPath: _subtitles.Array.data[11].text
      value: 'Ayoub, under our imam you have dedicated your life to meaning, I have
        dedicated mine to knowledge, '
      objectReference: {fileID: 0}
    - target: {fileID: 4213974095151647054, guid: 6ce0cebe207ad3a43928c373e8daa03a,
        type: 3}
      propertyPath: _subtitles.Array.data[12].text
      value: "but is this not wrong? Shouldn\u2019t the scientist and the philosopher
        work hand in hand?"
      objectReference: {fileID: 0}
    - target: {fileID: 4213974095151647054, guid: 6ce0cebe207ad3a43928c373e8daa03a,
        type: 3}
      propertyPath: _subtitles.Array.data[13].text
      value: 0.5
      objectReference: {fileID: 0}
    - target: {fileID: 4213974095151647054, guid: 6ce0cebe207ad3a43928c373e8daa03a,
        type: 3}
      propertyPath: _subtitles.Array.data[14].text
      value: Rubbish...
      objectReference: {fileID: 0}
    - target: {fileID: 4213974095151647054, guid: 6ce0cebe207ad3a43928c373e8daa03a,
        type: 3}
      propertyPath: _subtitles.Array.data[15].text
      value: Excuse me?
      objectReference: {fileID: 0}
    - target: {fileID: 4213974095151647054, guid: 6ce0cebe207ad3a43928c373e8daa03a,
        type: 3}
      propertyPath: _subtitles.Array.data[16].text
      value: All of your questions have already been answered old man.
      objectReference: {fileID: 0}
    - target: {fileID: 4213974095151647054, guid: 6ce0cebe207ad3a43928c373e8daa03a,
        type: 3}
      propertyPath: _subtitles.Array.data[17].text
      value: How long has it been since you last opened the holy Quran?
      objectReference: {fileID: 0}
    - target: {fileID: 4213974095151647054, guid: 6ce0cebe207ad3a43928c373e8daa03a,
        type: 3}
      propertyPath: _subtitles.Array.data[18].text
      value: Ayoub!
      objectReference: {fileID: 0}
    - target: {fileID: 4213974095151647054, guid: 6ce0cebe207ad3a43928c373e8daa03a,
        type: 3}
      propertyPath: _subtitles.Array.data[19].text
      value: No no no. Let him answer.
      objectReference: {fileID: 0}
    - target: {fileID: 4213974095151647054, guid: 6ce0cebe207ad3a43928c373e8daa03a,
        type: 3}
      propertyPath: _subtitles.Array.data[20].text
      value: 
      objectReference: {fileID: 0}
    - target: {fileID: 4213974095151647054, guid: 6ce0cebe207ad3a43928c373e8daa03a,
        type: 3}
      propertyPath: _subtitles.Array.data[21].text
      value: "These two\u2026"
      objectReference: {fileID: 0}
    - target: {fileID: 4213974095151647054, guid: 6ce0cebe207ad3a43928c373e8daa03a,
        type: 3}
      propertyPath: _subtitles.Array.data[22].text
      value: 
      objectReference: {fileID: 0}
    - target: {fileID: 4213974095151647054, guid: 6ce0cebe207ad3a43928c373e8daa03a,
        type: 3}
      propertyPath: _subtitles.Array.data[23].text
      value: Just what is this place?
      objectReference: {fileID: 0}
