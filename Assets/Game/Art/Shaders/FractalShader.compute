#pragma kernel CSMain

RWTexture2D<float4> Destination;

float4x4 _CameraToWorld;
float4x4 _CameraInverseProjection;
float3 _LightDirection;

float power;
float darkness;
float blackAndWhite;
float4 colourAMix;
float4 colourBMix;
float maxDst;
float alpha;
float fractalScale;

int maxStepCount;
int maxIterations;
float3 positionOffset;
float3 fractalRotation;

static const float epsilon = 0.003f;

struct Ray
{
    float3 origin;
    float3 direction;
};

Ray CreateCameraRay(float2 uv)
{
    float3 origin = mul(_CameraToWorld, float4(0, 0, 0, 1)).xyz;
    float3 destination = mul(_CameraInverseProjection, float4(uv, 0, 1)).xyz;
    destination = mul(_CameraToWorld, float4(destination, 1)).xyz;
    float3 direction = normalize(destination - origin);
    
    Ray ray;
    ray.origin = origin;
    ray.direction = direction;
    return ray;
}

float3x3 RotationMatrix(float3 rotation)
{
    float3 rad = rotation * 0.017453292;
    float cx = cos(rad.x);
    float sx = sin(rad.x);
    float cy = cos(rad.y);
    float sy = sin(rad.y);
    float cz = cos(rad.z);
    float sz = sin(rad.z);
    
    float3x3 rotX = float3x3(
        1, 0, 0,
        0, cx, -sx,
        0, sx, cx
    );
    
    float3x3 rotY = float3x3(
        cy, 0, sy,
        0, 1, 0,
        -sy, 0, cy
    );
    
    float3x3 rotZ = float3x3(
        cz, -sz, 0,
        sz, cz, 0,
        0, 0, 1
    );
    
    return mul(mul(rotZ, rotY), rotX);
}

float2 SceneInfo(float3 position)
{
    float3 localPos = position - positionOffset;
    float3x3 rotMatrix = RotationMatrix(-fractalRotation);
    localPos = mul(rotMatrix, localPos);
    localPos /= fractalScale;
    
    float3 z = localPos;
    float dr = 1.0;
    float r = 0.0;
    int iterations = 0;

    for (int i = 0; i < maxIterations; i++)
    {
        iterations = i;
        r = length(z);

        if (r > 2)
        {
            break;
        }

        float theta = acos(clamp(z.z / r, -1.0, 1.0));
        float phi = atan2(z.y, z.x);
        dr = pow(r, power - 1.0) * power * dr + 1.0;

        float zr = pow(r, power);
        theta = theta * power;
        phi = phi * power;

        z = zr * float3(sin(theta) * cos(phi), sin(phi) * sin(theta), cos(theta));
        z += localPos;
    }

    float dst = 0.5 * log(r) * r / dr;
    dst = max(dst * fractalScale * 0.99, 0.0001);
    return float2(iterations, dst);
}
float2 MandelbulbDE(float3 position)
{
    float3 localPos = position - positionOffset;
    float3x3 rotMatrix = RotationMatrix(-fractalRotation);
    localPos = mul(rotMatrix, localPos);
    localPos /= fractalScale;
    
    float3 z = localPos;
    float dr = 1.0;
    float r = 0.0;
    int iterations = 0;

    for (int i = 0; i < maxIterations; i++)
    {
        r = length(z);
        
        if (r > 2.0)
        {
            iterations = i;
            break;
        }

        float theta = acos(clamp(z.z / r, -1.0, 1.0));
        float phi = atan2(z.y, z.x);
        dr = pow(r, power - 1.0) * power * dr + 1.0;

        float zr = pow(r, power);
        theta *= power;
        phi *= power;

        z = zr * float3(sin(theta) * cos(phi), sin(phi) * sin(theta), cos(theta));
        z += localPos;
        iterations = i + 1;
    }

    float dst = 0.5 * log(r) * r / dr;
    dst = max(dst * fractalScale, 0.0001);
    return float2(iterations, dst);
}

float3 EstimateNormalTetrahedral(float3 p)
{
    float2 k = float2(1, -1);
    return normalize(
        k.xyy * MandelbulbDE(p + k.xyy * epsilon).y +
        k.yyx * MandelbulbDE(p + k.yyx * epsilon).y +
        k.yxy * MandelbulbDE(p + k.yxy * epsilon).y +
        k.xxx * MandelbulbDE(p + k.xxx * epsilon).y
    );
}

[numthreads(8, 8, 1)]
void CSMain(uint3 id : SV_DispatchThreadID)
{
    uint width, height;
    Destination.GetDimensions(width, height);
    
    if (id.x >= width || id.y >= height)
        return;

    float2 uv = id.xy / float2(width, height);
    float4 result = float4(1, 1, 1, alpha);
    
    Ray ray = CreateCameraRay(uv * 2 - 1);
    float rayDst = 0;
    int marchSteps = 0;

    while (rayDst < maxDst && marchSteps < maxStepCount)
    {
        marchSteps++;
        float2 sceneInfo = SceneInfo(ray.origin);
        float dst = sceneInfo.y;

        if (dst <= epsilon * rayDst * 0.5)
        {
            float escapeIterations = sceneInfo.x;
            float3 normal = EstimateNormalTetrahedral(ray.origin - ray.direction * epsilon * 2.0);
            
            float colourA = saturate(dot(normal * 0.5 + 0.5, -_LightDirection));
            float colourB = escapeIterations / 16.0;
            float3 colourMix = saturate(colourA * colourAMix.xyz + colourB * colourBMix.xyz);
            
            result.xyz = colourMix.xyz;
            result.a = lerp(colourBMix.a, colourAMix.a, 1 - clamp(smoothstep(0, .7, colourB), 0, 1));
            break;
        }

        dst = min(dst, 0.1);
        
        ray.origin += ray.direction * dst;
        rayDst += dst;
    }

    float rim = marchSteps / darkness;
    float4 dest = lerp(float4(result.xyz, 0), result, blackAndWhite * rim);
    Destination[id.xy] = dest;
}